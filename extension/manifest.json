{
  "manifest_version": 3,
  "name": "Cooldown Tracker",
  "version": "1.0.0",
  "description": "Controla pausas entre visitas y bloquea sitios durante el cooldown.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["alarms", "favicon", "notifications", "storage", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Abrir Cooldown Tracker",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
